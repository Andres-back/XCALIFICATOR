# XCalificator - production template
# Copy this file to .env on the VPS and fill real values.

# Database
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=
POSTGRES_DB=xcalificator_db
DATABASE_URL=postgresql+asyncpg://xcalificator:CHANGE_POSTGRES_PASSWORD@postgres:5432/xcalificator_db

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0

# Runtime
ENVIRONMENT=production
JWT_SECRET=
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Initial admin user. The backend may use these values only if bootstrap logic is enabled.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DOCUMENT=BOOTSTRAP-ADMIN

# AI providers
GROQ_API_KEY=
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_PRESENTATION_MODEL=
OCR_OLLAMA_MODEL=gemma3
OCR_GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Frontend and allowed hosts
# Use https://your-domain.example with nginx.prod.conf.
# For temporary IP testing, set NGINX_CONF=nginx.http.conf and use http://YOUR_IP.
VITE_API_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
TRUSTED_HOSTS=your-domain.example,www.your-domain.example,localhost,127.0.0.1,backend
NGINX_CONF=nginx.prod.conf

# Google OAuth and Google Slides
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SLIDES_EXPORT_ENABLED=false
GOOGLE_SLIDES_PARENT_FOLDER_ID=
GOOGLE_SLIDES_SHARE_TO_ANYONE=false

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# OCR
OCR_SERVICE_URL=http://paddleocr:8001

# Image and presentation services
PRESENTON_URL=http://presenton:80
PRESENTON_PUBLIC_URL=https://your-domain.example/presentations
PRESENTON_TIMEOUT=240
PRESENTON_LLM=custom
PRESENTON_CUSTOM_LLM_URL=https://api.groq.com/openai/v1
PRESENTON_CUSTOM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PRESENTON_DISABLE_IMAGE_GENERATION=false
PRESENTON_AUTH_USERNAME=xcalificator
PRESENTON_AUTH_PASSWORD=
