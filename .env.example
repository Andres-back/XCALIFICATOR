# ============================================================
# XCALIFICATOR - Variables de entorno
# Copia este archivo a .env y completa los valores reales
# cp .env.example .env
# ============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD
POSTGRES_DB=xcalificator_db
DATABASE_URL=postgresql+asyncpg://xcalificator:CAMBIA_ESTA_PASSWORD@postgres:5432/xcalificator_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT (usa una cadena larga y aleatoria) ---
JWT_SECRET=CAMBIA_ESTE_SECRET_POR_UNO_LARGO

# --- Groq API ---
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Google OAuth 2.0 ---
# Obtén estas credenciales en: https://console.cloud.google.com/
# Usa un cliente OAuth de tipo "Aplicación web"
# Agrega estos orígenes en "Orígenes autorizados de JavaScript":
# - http://localhost
# - http://localhost:3000
# - http://127.0.0.1
# - http://127.0.0.1:3000
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXX
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
VITE_API_URL=
# Solo para `npm run dev` (Vite proxy). En local normalmente localhost:8000.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail

# --- WhatsApp (Whapi - opcional) ---
WHAPI_TOKEN=

# --- Pollinations (generación de imágenes) ---
# Obtén tu clave en: https://pollinations.ai/
POLLINATIONS_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXX

# --- OCR ---
OCR_SERVICE_URL=http://paddleocr:8001

# --- Presenton (generador de presentaciones IA) ---
# Microservicio interno; usa la misma GROQ_API_KEY como proveedor LLM
PRESENTON_URL=http://presenton:80
PRESENTON_API_URL=
PRESENTON_PUBLIC_URL=http://localhost:5001
PRESENTON_TIMEOUT=240
PRESENTON_LLM=custom
PRESENTON_CUSTOM_LLM_URL=https://api.groq.com/openai/v1
# Recomendado para evitar error de json_schema en Groq
PRESENTON_CUSTOM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PRESENTON_IMAGE_PROVIDER=pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
PRESENTON_AUTH_USERNAME=
PRESENTON_AUTH_PASSWORD=
PRESENTON_AUTH_OVERRIDE_FROM_ENV=false
